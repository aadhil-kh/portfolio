# Cloudflare Pages response headers.
# Rules are matched most-specific-first; a file matching several rules gets the
# union of their headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro fingerprints everything under /_astro/, so a given URL's bytes never
# change. Anything less than immutable means a revalidation round trip per
# asset per visit.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Release archives carry their version in the filename, so the same rule holds.
# These are what the Flatpak and Snap builds fetch.
/media/releases/*
  Cache-Control: public, max-age=31536000, immutable

# Flathub re-reads this to confirm the domain still vouches for the app, so it
# must not sit in a cache after I change it.
/.well-known/*
  Cache-Control: public, max-age=300
