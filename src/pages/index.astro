---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileNav from '../components/MobileNav.astro';
import type { MobileNavItem } from '../components/MobileNav.astro';
import AppCard from '../components/AppCard.astro';
import ScreenshotCarousel from '../components/ScreenshotCarousel.astro';
import { LISTED_APPS } from '../data/apps';

// Which apps have published releases, so their card can link to the changelog.
const releases = (await getCollection('changelog')).filter(
  (e) => import.meta.env.DEV || !e.data.draft,
);
const appsWithReleases = new Set(releases.map((e) => e.data.app));

const mobileItems: MobileNavItem[] = [
  { href: '#profile', label: 'Home', icon: 'home', section: 'profile', active: true },
  { href: '#services', label: 'Services', icon: 'services', section: 'services' },
  { href: '#apps', label: 'Apps', icon: 'apps', section: 'apps' },
  { href: '#experience', label: 'Work', icon: 'work', section: 'experience' },
  { href: '#contact', label: 'Contact', icon: 'contact', section: 'contact' },
];
