  <script>
    // --- Experience durations ---
    // Each .exp-duration carries data-from / data-to as YYYY-MM (data-to empty
    // means present). Months are counted inclusively, the way LinkedIn does,
    // and overlapping roles are only counted once in the total.
    (function () {
      const now = new Date();
      const toIndex = (s: string | undefined) => {
        if (!s) return now.getFullYear() * 12 + now.getMonth();
        const [y, m] = s.split('-').map(Number);
        return y * 12 + (m - 1);
      };
      const plural = (n: number, unit: string) => `${n} ${unit}${n === 1 ? '' : 's'}`;
      const format = (months: number) => {
        const y = Math.floor(months / 12),
          m = months % 12;
        return [y && plural(y, 'yr'), m && plural(m, 'mo')].filter(Boolean).join(' ') || '1 mo';
      };

      const worked = new Set<number>();
      document.querySelectorAll<HTMLElement>('.exp-duration').forEach((el) => {
        const from = toIndex(el.dataset.from),
          to = toIndex(el.dataset.to);
        for (let i = from; i <= to; i++) worked.add(i);
        el.textContent = format(to - from + 1);
      });

      const years = Math.floor(worked.size / 12);
      document
        .querySelectorAll('[data-total-exp]')
        .forEach((el) => (el.textContent = `${format(worked.size)} total`));
      document
        .querySelectorAll('[data-total-years]')
        .forEach((el) => (el.textContent = `${years}+`));
    })();

    // --- Mobile nav active state via IntersectionObserver ---
    const navItems = document.querySelectorAll('.mobile-nav-item');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navItems.forEach((i) => i.classList.remove('active'));
            const active = document.querySelector(
              `.mobile-nav-item[data-section="${entry.target.id}"]`,
            );
            if (active) active.classList.add('active');
          }
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );

    ['profile', 'services', 'apps', 'experience', 'contact'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  </script>
