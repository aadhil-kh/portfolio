---
import type { ComponentProps } from 'astro/types';
import BaseLayout from './BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileNav from '../components/MobileNav.astro';
import type { MobileNavItem } from '../components/MobileNav.astro';

/** Everything BaseLayout takes for the <head>, plus which nav item is lit. */
export type Props = Omit<ComponentProps<typeof BaseLayout>, 'suffixTitle'> & {
  active?: 'changelog' | 'blog' | null;
};

const { active = null, ...head } = Astro.props;

const mobileItems: MobileNavItem[] = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/#apps', label: 'Apps', icon: 'apps' },
  { href: '/changelog/', label: 'Changelog', icon: 'changelog', active: active === 'changelog' },
  { href: '/blog/', label: 'Blog', icon: 'blog', active: active === 'blog' },
  { href: '/#contact', label: 'Contact', icon: 'contact' },
];
---

<BaseLayout {...head}>
  <SiteNav variant="page" active={active} />
  <div class="container">
    <main>
      <slot />
    </main>
    <SiteFooter />
  </div>
  <MobileNav items={mobileItems} />
</BaseLayout>
