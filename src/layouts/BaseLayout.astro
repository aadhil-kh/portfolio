---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image for social cards. */
  ogImage?: string;
  /** Set on long-form pages so the browser tab reads "<page> - Mohammed Aadhil". */
  suffixTitle?: boolean;
}

const { title, description, ogImage, suffixTitle = true } = Astro.props;

const fullTitle = suffixTitle ? `${title} - Mohammed Aadhil` : title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fafafa" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <slot />

    <script>
      // --- Booking link ---
      // Each [data-book-call] names a cal.com event slug under CAL_URL.
      // While CAL_URL is empty, every button falls back to its own mailto: href.
      const CAL_URL = 'https://cal.com/aadhil-kh';

      if (CAL_URL) {
        document.querySelectorAll<HTMLAnchorElement>('[data-book-call]').forEach((a) => {
          const event = a.dataset.bookCall;
          a.href = event ? `${CAL_URL}/${event}` : CAL_URL;
          a.target = '_blank';
          a.rel = 'noopener';
        });
      }
    </script>
  </body>
</html>
